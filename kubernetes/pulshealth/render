#!/usr/bin/env bash
# Vendors upstream PulsHealth's schema migrator and migrations for the release
# the app images run, into upstream/. Images and migrations must come from the
# same release, and the database must run the image that release pins.
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$BASEDIR"

image_tag() {
  yq -r ".spec.template.spec.containers[] | select(.name == \"$1\") | .image" deploy.yaml \
    | sed -E 's/^[^:]+:([^@]+)@sha256:[0-9a-f]{64}$/\1/'
}

version="$(image_tag ingest)"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Expected the ingest image to be <version>@sha256:<digest>, got: $version" >&2
  exit 1
fi
for container in api web; do
  if [[ "$(image_tag "$container")" != "$version" ]]; then
    echo "The $container image is not on PulsHealth $version; the three app images must match" >&2
    exit 1
  fi
done

rm -rf tmp upstream
mkdir -p tmp upstream/migrations
curl -fsSL "https://codeload.github.com/PulsHealth/pulshealth/tar.gz/refs/tags/v${version}" \
  | tar -xzf - -C tmp --strip-components=1 \
    "pulshealth-${version}/server/db/migrate.sh" \
    "pulshealth-${version}/server/db/migrations" \
    "pulshealth-${version}/server/docker-compose.yml"
cp tmp/server/db/migrate.sh upstream/migrate.sh
cp tmp/server/db/migrations/* upstream/migrations/

# The database and the migrate init container run the image upstream
# tested this release with. The compose file is read here, not vendored,
# so Renovate never sees its images.
db_image="docker.io/$(yq -r '.["x-db-image"]' tmp/server/docker-compose.yml)"
rm -rf tmp
while read -r image; do
  if [[ "${image%@*}" != "$db_image" ]]; then
    echo "TimescaleDB image ${image%@*} does not match upstream's $db_image" >&2
    exit 1
  fi
done < <(
  yq -r '.spec.images[].image' imagecatalog.yaml
  yq -r '.spec.template.spec.initContainers[].image' deploy.yaml
)

# Three ConfigMaps rather than one: each object's last-applied-configuration
# annotation must stay under Kubernetes' 256 KiB annotation limit.
{
  echo '---'
  echo 'apiVersion: kustomize.config.k8s.io/v1beta1'
  echo 'kind: Kustomization'
  echo
  echo "# Generated by ../render from PulsHealth v${version}. Do not edit."
  echo
  echo 'configMapGenerator:'
  echo '- name: pulshealth-migrate-bin'
  echo '  files:'
  echo '  - migrate.sh'
  echo '- name: pulshealth-migrate-sql'
  echo '  files:'
  (cd upstream && find migrations -name '[0-9][0-9][0-9]_*.sql' | LC_ALL=C sort | sed 's/^/  - /')
  echo '- name: pulshealth-migrate-scripts'
  echo '  files:'
  (cd upstream && find migrations -name '[0-9][0-9][0-9]_*.sh' | LC_ALL=C sort | sed 's/^/  - /')
  echo
  echo 'generatorOptions:'
  echo '  disableNameSuffixHash: true'
} >upstream/kustomization.yaml
