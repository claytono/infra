#!/usr/bin/env python3
"""Print kustomization resources entries read from stdin, one per line, in
the order .kyverno/policies/require-sorted-kustomization-resources.yaml
requires.

namespace.yaml comes first. Then, at every directory level, files come
before subdirectories, each sorted by name without .yaml or .yml, so
storageclass comes before storageclass-slow. An entry without a YAML
extension is a directory.
"""

import re
import sys

YAML_EXT = re.compile(r"\.ya?ml$")


def sort_key(entry):
    if entry == "namespace.yaml":
        return (0, [])
    if YAML_EXT.search(entry):
        *dirs, name = entry.split("/")
        return (1, [(1, d) for d in dirs] + [(0, YAML_EXT.sub("", name))])
    return (1, [(1, d) for d in entry.rstrip("/").split("/")])


entries = [line for line in sys.stdin.read().splitlines() if line]
sys.stdout.write("".join(f"{e}\n" for e in sorted(entries, key=sort_key)))
