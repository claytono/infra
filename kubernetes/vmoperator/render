#!/bin/bash

set -eu -o pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$BASEDIR"

source "$BASEDIR/../scripts/chart-version"

rm -rf helm tmp
mkdir tmp helm

helm_template vmoperator victoria-metrics-operator \
	--include-crds \
	--values values.yaml \
	--namespace vmoperator \
	--output-dir tmp

mv tmp/victoria-metrics-operator/templates/* helm/
mv tmp/victoria-metrics-operator/charts/crds/crds/crd.yaml helm/crd.yaml
rm -rf tmp
