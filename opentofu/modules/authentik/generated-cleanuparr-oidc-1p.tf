###############################################
# Auto-generated by ak-tool for cleanuparr OIDC 1Password item
###############################################

resource "random_password" "cleanuparr_oidc" {
  length  = 32
  special = false
}

locals {
  # OpenTofu is the source of truth for OIDC client credentials
  cleanuparr_oidc_client_id = "cleanuparr"
  cleanuparr_oidc_secret    = random_password.cleanuparr_oidc.result
}

resource "onepassword_item" "cleanuparr_oidc" {
  vault    = var.onepassword_vault_uuid
  title    = "cleanuparr-oidc"
  category = "login"

  note_value = "OIDC client for cleanuparr. Managed by OpenTofu — do not edit manually."

  section {
    label = "OIDC"
    field {
      label = "client-id"
      type  = "STRING"
      value = local.cleanuparr_oidc_client_id
    }
    field {
      label = "client-secret"
      type  = "CONCEALED"
      value = local.cleanuparr_oidc_secret
    }
  }
}
