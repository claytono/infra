#!/usr/bin/env python3
"""Generate the node_exporter scrape targets from the Ansible inventory.

Every inventory host whose node_exporter_enabled is true is scraped at
<ansible_host>:<node_exporter_port>, or at node_exporter_scrape_address when
the cluster reaches it another way. The result is a VMStaticScrape in the
"node resources" job, so the NodeDown alert covers every host. xtal is not in
the inventory and stays in kubernetes/victoria-metrics/config/vmagent.yaml.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

# Paths relative to repo root
REPO_ROOT = Path(__file__).parent.parent
ANSIBLE_DIR = REPO_ROOT / "ansible"
INVENTORY = ANSIBLE_DIR / "inventory" / "default"
OUTPUT_FILE = (
    REPO_ROOT / "kubernetes" / "victoria-metrics" / "vmstaticscrape-node-exporters.yaml"
)

JOB_NAME = "node resources"


def read_hostvars() -> dict[str, dict]:
    """Return each inventory host's variables as Ansible resolves them.

    Runs ansible-inventory with a config that has no vault password file, as
    scripts/ansible-lint-wrapper does, so it works in CI. Vaulted values stay
    encrypted; none of the variables read here are vaulted.
    """
    env = {k: v for k, v in os.environ.items() if not k.startswith("ANSIBLE_")}
    with tempfile.TemporaryDirectory() as tmp:
        config = Path(tmp) / "ansible.cfg"
        config.write_text("[defaults]\n", encoding="utf-8")
        env["ANSIBLE_CONFIG"] = str(config)
        result = subprocess.run(
            [
                "ansible-inventory",
                "-i",
                str(INVENTORY),
                "--playbook-dir",
                str(ANSIBLE_DIR),
                "--list",
            ],
            env=env,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            check=False,
        )
    if result.returncode != 0:
        print(result.stderr, file=sys.stderr)
        sys.exit(f"ansible-inventory failed with exit code {result.returncode}")
    return json.loads(result.stdout)["_meta"]["hostvars"]


def plain_string(host: str, name: str, value, errors: list[str]) -> str | None:
    """Return value if it is a non-empty, untemplated string."""
    if not isinstance(value, str) or not value:
        errors.append(f"{host}: {name} must be a non-empty string, got {value!r}")
        return None
    if "{{" in value or "{%" in value:
        # ansible-inventory doesn't evaluate templates.
        errors.append(f"{host}: {name} must not be templated, got {value!r}")
        return None
    return value


def collect_targets(hostvars: dict[str, dict]) -> tuple[list[dict], list[str]]:
    """Return (targets, errors); each target has an address and an instance."""
    targets = []
    errors = []

    for host in sorted(hostvars):
        hv = hostvars[host]

        enabled = hv.get("node_exporter_enabled")
        if not isinstance(enabled, bool):
            errors.append(
                f"{host}: node_exporter_enabled must be true or false, got {enabled!r}"
            )
            continue
        if not enabled:
            continue

        port = hv.get("node_exporter_port")
        if not isinstance(port, int) or isinstance(port, bool):
            errors.append(
                f"{host}: node_exporter_port must be an integer, got {port!r}"
            )
            continue

        ansible_host = plain_string(
            host, "ansible_host", hv.get("ansible_host"), errors
        )
        if ansible_host is None:
            continue
        instance = f"{ansible_host}:{port}"

        address = instance
        if "node_exporter_scrape_address" in hv:
            address = plain_string(
                host,
                "node_exporter_scrape_address",
                hv["node_exporter_scrape_address"],
                errors,
            )
            if address is None:
                continue

        targets.append({"address": address, "instance": instance})

    return targets, errors


def generate_yaml(targets: list[dict]) -> str:
    """Generate the VMStaticScrape manifest."""
    lines = [
        "---",
        "# AUTO-GENERATED - DO NOT EDIT",
        "# Generated by: scripts/gen-node-exporter-targets",
        "# Source: node_exporter_enabled, ansible_host, node_exporter_port and",
        "# node_exporter_scrape_address in the Ansible inventory",
        "apiVersion: operator.victoriametrics.com/v1beta1",
        "kind: VMStaticScrape",
        "",
        "metadata:",
        "  name: node-exporters",
        "",
        "spec:",
        f"  jobName: {JOB_NAME}",
        "  targetEndpoints:",
    ]

    direct = [t for t in targets if t["address"] == t["instance"]]
    indirect = [t for t in targets if t["address"] != t["instance"]]

    # Values are quoted, as JSON strings, so an address such as "[fd00::1]:9100"
    # isn't read as YAML syntax.
    if direct:
        lines.append("  - targets:")
        lines.extend(f"    - {json.dumps(t['address'])}" for t in direct)

    # A host scraped through another address keeps its own name as instance.
    for t in indirect:
        lines.append("  - targets:")
        lines.append(f"    - {json.dumps(t['address'])}")
        lines.append("    labels:")
        lines.append(f"      instance: {json.dumps(t['instance'])}")

    lines.append("")
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(
        description="Generate the node_exporter VMStaticScrape from the Ansible inventory"
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check if generated file matches existing file",
    )
    args = parser.parse_args()

    targets, errors = collect_targets(read_hostvars())

    if errors:
        print("Validation errors:", file=sys.stderr)
        for error in errors:
            print(f"  {error}", file=sys.stderr)
        sys.exit(1)

    if not targets:
        sys.exit("No inventory host has node_exporter_enabled set to true")

    content = generate_yaml(targets)

    # Check mode - compare against existing file
    if args.check:
        if OUTPUT_FILE.exists() and OUTPUT_FILE.read_text(encoding="utf-8") == content:
            sys.exit(0)
        print(
            f"{OUTPUT_FILE} is out of date.\n\n"
            "Run:\n"
            "  scripts/gen-node-exporter-targets\n\n"
            "Then commit the updated vmstaticscrape-node-exporters.yaml",
            file=sys.stderr,
        )
        sys.exit(1)

    OUTPUT_FILE.write_text(content, encoding="utf-8")
    print(f"Generated {OUTPUT_FILE} with {len(targets)} targets")


if __name__ == "__main__":
    main()
