#!/usr/bin/env bash
# Run in a new worktree's first pane by the herdr worktree-setup plugin in
# the dotfiles repo (config/herdr/plugins/worktree-setup), after it has
# fetched, moved the worktree to the latest origin/main and approved .envrc,
# and before it starts Claude.
#
# Worktrees use the main checkout's gitignored secrets, which go stale when a
# template changes upstream. Bring the main checkout up to date, offer to
# regenerate any secrets its templates have outgrown, and link the secret
# files that worktrees otherwise lack.

set -euo pipefail

worktree=$(git rev-parse --show-toplevel)
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
if [[ -z $main || $main == "$worktree" ]]; then
  exit 0
fi

# The plugin has already fetched origin.
update_main_checkout() {
  local branch

  branch=$(git -C "$main" branch --show-current)
  if [[ $branch != main ]]; then
    echo "warning: $main is on ${branch:-a detached HEAD}, not main; secrets are checked against its current templates, which may be older than this worktree's" >&2
  elif ! git -C "$main" merge --ff-only --quiet origin/main; then
    echo "warning: could not fast-forward $main to origin/main; secrets are checked against its current templates, which may be older than this worktree's" >&2
  fi
}

# The shared secrets follow the main checkout's templates. A branch that
# changes a template itself, such as one adding a secret, needs them
# regenerated by hand once it is ready.
note_branch_templates() {
  local template target

  for template in .secrets.tmpl esphome/secrets.tmpl; do
    if [[ -f $template ]] && ! cmp -s "$template" "$main/$template"; then
      case $template in
        .secrets.tmpl) target=direnv ;;
        esphome/secrets.tmpl) target=esphome ;;
      esac
      echo "note: this branch changes $template; run scripts/bootstrap-secrets --apply $target once it is ready"
    fi
  done
}

# bootstrap-secrets --check reads only local files; --apply asks 1Password,
# so ask first.
offer_secrets_update() {
  local stale=() target reply

  for target in direnv esphome ansible; do
    if ! "$main/scripts/bootstrap-secrets" --check "$target" >/dev/null; then
      stale+=("$target")
    fi
  done
  if ((${#stale[@]} == 0)); then
    return 0
  fi

  echo
  "$main/scripts/bootstrap-secrets" --check "${stale[@]}" || true
  echo
  # A failed read, such as Ctrl-D, counts as no.
  read -r -p "Update ${stale[*]} secrets now? 1Password will ask for your fingerprint. [y/N] " reply ||
    reply=
  if [[ $reply == [yY]* ]]; then
    # A failed update, such as a declined fingerprint, shouldn't stop the
    # links and Claude from following.
    if ! "$main/scripts/bootstrap-secrets" --apply "${stale[@]}"; then
      echo "warning: could not update ${stale[*]} secrets; continuing" >&2
    fi
  else
    echo "Leaving them as they are."
  fi
}

# .envrc already reads .secrets.age from the main checkout. These two are
# read by path, so link them, even before the main checkout has them; a link
# follows later updates there.
link_secret_files() {
  local file

  for file in esphome/secrets.yaml ansible/ansible-vault-password; do
    if [[ ! -e $file && ! -L $file ]]; then
      ln -s "$main/$file" "$file"
      echo "linked $file from $main"
    fi
  done
}

update_main_checkout
note_branch_templates
# Regenerating needs infra's tools, such as age, which come from .envrc.
if [[ ${WORKTREE_SETUP_ENVRC_LOADED:-} == 1 ]]; then
  offer_secrets_update
else
  echo "Skipping the secrets check: .envrc isn't loaded, so infra's tools aren't available."
fi
link_secret_files
