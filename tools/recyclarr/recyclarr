#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# renovate: datasource=docker
IMAGE="recyclarr/recyclarr:8.8.1@sha256:3e9c41b9ec29bbf65fe846864058730d321a21f7695d8c0d9437b73e34d50ad9"

docker run --rm \
  --user "$(id -u):$(id -g)" \
  -v "$SCRIPT_DIR/data:/config" \
  -e RADARR_API_KEY="${RADARR_API_KEY:-}" \
  -e SONARR_API_KEY="${SONARR_API_KEY:-}" \
  "$IMAGE" \
  "$@"
